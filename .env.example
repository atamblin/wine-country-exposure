# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.

# Canonical site URL. Used for metadata, sitemap, Open Graph, and payment return URLs.
NEXT_PUBLIC_SITE_URL="https://www.winecountryexposure.com"

# --- Aryeo (server only) ---------------------------------------------------
# Generate in Aryeo: group developer settings -> API keys.
# Sent as `Authorization: Bearer {token}`. Never expose this to the browser.
ARYEO_API_KEY=""

# The order form the quote builder hands off to. Run `npm run aryeo:check`
# after setting ARYEO_API_KEY to list your order forms and their IDs.
ARYEO_ORDER_FORM_ID=""

# --- Email (server only) ---------------------------------------------------
# Resend, for quote PDFs to agents and new-lead notifications to you.
# RESEND_API_KEY=""
# QUOTE_NOTIFY_FROM="Wine Country Exposure <quotes@winecountryexposure.com>"
# QUOTE_NOTIFY_TO=""

# --- Google Places (address autocomplete) ---------------------------------
# Restrict this key by HTTP referrer in Google Cloud before going live.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Analytics ------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
